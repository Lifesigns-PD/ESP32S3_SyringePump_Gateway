# ESP-IDF 4.4 configuration for the gateway (options that are the same for every flash size).
# Flash size and partition table come from platformio.ini (board_upload.flash_size, board_build.partitions).

# --- CPU, flash, size ----------------------------------------------------------------------------------------------------------
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y

# --- FreeRTOS: 1 ms tick like the earlier firmware (delay(1) in the loop, short waits) ---------------------------------------
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# --- console on UART0 (the TTL header). The firmware switches it off by itself while the pump line uses the same pins --------
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_LOG_DEFAULT_LEVEL_WARN=y

# --- LAN: WIZnet W5500 over SPI -------------------------------------------------------------------------------------------------
CONFIG_ETH_USE_SPI_ETHERNET=y
CONFIG_ETH_SPI_ETHERNET_W5500=y

# --- web server and sockets -----------------------------------------------------------------------------------------------------
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# --- NTP: the firmware uses two time servers -------------------------------------------------------------------------------------
CONFIG_LWIP_SNTP_MAX_SERVERS=2

# --- https to your server WITHOUT certificate check (HTTPS_ROOT_CA is nullptr in config.h, as before) ---------------------------
CONFIG_ESP_TLS_INSECURE=y
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y
